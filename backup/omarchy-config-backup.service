[Unit]
Description=Back up omarchy configuration to the hypervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# system services have no HOME, so set it before the script's defaults apply.
Environment=HOME=/root
# REMOTE, KEY and HOME_DIR belong here, not in the script.
EnvironmentFile=-/etc/homelab-backup.env
ExecStart=/usr/local/sbin/omarchy-config-backup.sh
