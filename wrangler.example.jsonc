// Shape of the deploy config that `bun run sync` generates from the local
// inventory. wrangler.jsonc itself is git-ignored and never edited by hand.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homelab",
  "main": "@tanstack/solid-start/server-entry",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [{ "binding": "INVENTORY", "id": "<kv-namespace-id>" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "example.com/*", "zone_name": "example.com" },
    { "pattern": "www.example.com/*", "zone_name": "example.com" }
  ]
}
